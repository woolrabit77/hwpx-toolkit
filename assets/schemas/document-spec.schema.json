{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HWPX Document Spec",
  "type": "object",
  "properties": {
    "template": {
      "type": ["null", "string"],
      "enum": [null, "none", "official-letter", "press-release", "statutory-form", "job-application", "kice-exam", "academic-humanities", "academic-stem", "policy-report"]
    },
    "metadata": {"type": "object"},
    "data": {"type": "object"},
    "header": {"$ref": "#/$defs/headerFooter"},
    "footer": {"$ref": "#/$defs/headerFooter"},
    "page_number": {"$ref": "#/$defs/pageNumber"},
    "replace_template_blocks": {"type": "boolean"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["blocks"],
        "properties": {
          "blocks": {"$ref": "#/properties/blocks"},
          "header": {"$ref": "#/$defs/headerFooter"},
          "footer": {"$ref": "#/$defs/headerFooter"},
          "page_number": {"$ref": "#/$defs/pageNumber"},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["paragraph", "heading", "equation", "table", "footnote", "endnote", "toc", "index", "page_break", "section_break", "chart", "tracked_change", "document_compare", "password", "distribution", "signature"]
          },
          "style": {"type": "string"},
          "text": {"type": "string"},
          "script": {"type": "string"},
          "tabs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["position"],
              "properties": {
                "position": {"type": "integer", "minimum": 0},
                "type": {"enum": ["LEFT", "CENTER", "RIGHT", "DECIMAL"]},
                "leader": {"enum": ["NONE", "SOLID", "DOTTED", "DASHED"]}
              }
            }
          },
          "tab_stops": {"$ref": "#/properties/blocks/items/properties/tabs"},
          "indent": {
            "type": "object",
            "properties": {
              "left": {"type": "integer"},
              "right": {"type": "integer"},
              "first_line": {"type": "integer"},
              "hanging": {"type": "integer"}
            },
            "additionalProperties": false
          },
          "bullet": {
            "oneOf": [
              {"type": "boolean"},
              {"type": "object", "properties": {"level": {"type": "integer", "minimum": 1, "maximum": 10}, "char": {"type": "string", "minLength": 1, "maxLength": 1}}}
            ]
          },
          "numbering": {
            "oneOf": [
              {"type": "boolean"},
              {"type": "object", "properties": {"level": {"type": "integer", "minimum": 1, "maximum": 10}, "start": {"type": "integer", "minimum": 1}, "format": {"type": "string"}}}
            ]
          },
          "list": {"type": "object"},
          "column_widths": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "row_heights_mm": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}},
          "header_rows": {"type": "integer", "minimum": 0},
          "border_style": {"enum": ["none", "plain", "subtle", "grid", "form"]},
          "shading": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
          "fill_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
          "split": {"enum": ["cell", "table", "none"]},
          "page_break": {"enum": ["cell", "table", "none"]},
          "repeat_header": {"type": "boolean"},
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {"type": ["string", "number", "boolean", "null"]},
                  {
                    "type": "object",
                    "properties": {
                      "value": {},
                      "formula": {"type": "string", "minLength": 1},
                      "style": {"type": "string"},
                      "shading": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                      "fill_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                      "row_span": {"type": "integer", "minimum": 1},
                      "col_span": {"type": "integer", "minimum": 1},
                      "span": {
                        "type": "object",
                        "properties": {
                          "rows": {"type": "integer", "minimum": 1},
                          "cols": {"type": "integer", "minimum": 1},
                          "row_span": {"type": "integer", "minimum": 1},
                          "col_span": {"type": "integer", "minimum": 1}
                        },
                        "additionalProperties": false
                      },
                      "merge": {"$ref": "#/properties/blocks/items/properties/rows/items/items/properties/span"},
                      "image": {"type": "object"}
                    },
                    "additionalProperties": true
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "headerFooter": {
      "oneOf": [
        {"type": "string"},
        {"type": "object", "properties": {"text": {"type": "string"}, "runs": {"type": "array"}, "blocks": {"type": "array"}}, "additionalProperties": true},
        {"type": "array"}
      ]
    },
    "pageNumber": {
      "oneOf": [
        {"type": "boolean", "const": true},
        {"type": "object", "properties": {"position": {"enum": ["TOP_LEFT", "TOP_CENTER", "TOP_RIGHT", "BOTTOM_LEFT", "BOTTOM_CENTER", "BOTTOM_RIGHT"]}, "format": {"enum": ["DIGIT", "ROMAN_SMALL", "ROMAN_CAPITAL", "LATIN_SMALL", "LATIN_CAPITAL"]}, "formatType": {"type": "string"}, "side_char": {"type": "string", "maxLength": 2}, "start": {"type": "integer", "minimum": 1}}, "additionalProperties": false}
      ]
    }
  },
  "additionalProperties": true
}
